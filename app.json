{
  "expo": {
    "name": "iveLive",
    "slug": "ivelive",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "ivelive",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ivelive.app",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.ivelive.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "src/app"
        }
      ],
      "expo-font",
      "expo-splash-screen",
      [
        "expo-image",
        {
          "photosPermission": "IveLive uses your photos to add artist images."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "IveLive uses your photo library to add keepsakes to concert logs.",
          "cameraPermission": "IveLive uses your camera to take a keepsake for a concert log.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "IveLive uses your location to find nearby tour dates. Location stays private."
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
